<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime (required for notarization) still lets the
       capture daemon use the microphone. Screen and system audio capture
       (ScreenCaptureKit) need no entitlement: macOS asks the user. -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
