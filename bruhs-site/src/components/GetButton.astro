---
import Icon from "./Icon.astro";
---
<a class="btn btn-primary for-desktop" href="/download">
  <Icon name="apple" />
  <Icon name="windows" />
  {/* Larry Ewing's Tux, from linux/drivers/video/logo/logo_linux_clut224.ppm. */}
  <img class="icon-linux" src="/tux.png" width="16" height="16" alt="" />
  <span class="os-mac">Download for macOS</span>
  <span class="os-windows">Download for Windows</span>
  <span class="os-linux">Download for Linux</span>
  <span class="os-other">Download for desktop</span>
</a>
<button class="btn btn-primary for-phone" type="button" data-share><span data-label>Send to desktop</span></button>
<span class="sr-only for-phone" data-share-status role="status"></span>
<input class="share-url for-phone" data-share-url type="url" value="https://bruhs.ai/download" aria-label="Download page link" readonly hidden>
