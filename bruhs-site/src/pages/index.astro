---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import GetButton from "../components/GetButton.astro";
import SurfacePanel from "../components/SurfacePanel.astro";

const surfaces = [
  { id: "tasks", label: "Today", color: "tasks", file: "tasks", width: 1168,
    alt: "The Today view: a briefing, the current focus block and the rest of the day's schedule, a ranked focus queue with priorities and estimates, and columns for overdue work, waiting on, follow-ups and decisions.",
    caption: "Today: what's due, what's blocked, and who you're waiting on." },
  { id: "meetings", label: "Meetings", color: "meetings", file: "meetings", width: 1168,
    alt: "A recorded meeting: the end of a speaker-labeled transcript, then a summary, four action items with due dates, the decisions made, and topics.",
    caption: "Meeting notes without a bot in the call, transcribed on your Mac." },
  { id: "agents", label: "Agents", color: "agent", file: "hero", width: 1440,
    alt: "The bruhs app: a sidebar of Claude and Codex threads across several projects, and an open thread where Claude reads session.rs, runs cargo test, explains a race on a shared test clock, and shows a two-file diff.",
    caption: "Claude Code and Codex threads, with every tool call, diff and a terminal." },
  { id: "calendar", label: "Calendar", color: "calendar", file: "calendar", width: 1168,
    alt: "A week in the bruhs calendar: meetings, blue focus blocks for tasks like the flaky auth test and the launch post, green workouts, and evening plans, with a line marking the current time on Wednesday.",
    caption: "“Plan my day” turns estimates into focus blocks around your meetings." },
  { id: "people", label: "People", color: "people", file: "people", width: 1168,
    alt: "A person in bruhs: company, role and contact details, private notes, a suggested follow-up, and a list of commitments, reminders and past interactions.",
    caption: "A CRM that fills itself in from your meetings and messages." },
  { id: "notes", label: "Notes", color: "notes", file: "notes", width: 1168,
    alt: "The Notes view: tagged Markdown documents such as a pilot plan and a launch checklist, and saved web clips that keep their source.",
    caption: "Docs and web clips your agent can read." },
  { id: "life", label: "Life", color: "life", file: "life", width: 1168,
    alt: "The finance side of Life: net worth, 30-day spend and expected income, the agent-access and redaction switches, a list of accounts, and recent transactions.",
    caption: "Money and health, hidden from the agent until you opt in." },
];
---

<Base
  title="bruhs | Your digital brain"
  description="Your local-first digital brain for meeting notes, people, tasks and agent conversations. Free, open source, for macOS, Windows and Linux."
  ogDescription="Find the decision from your last meeting, remember who needs a follow-up, and see what’s due today."
  path="/"
  current="home"
  palette
>
  <main id="main" tabindex="-1">
    <section class="hero">
      <div class="wrap memory-hero">
        <div class="hero-copy">
          <h1 class="display">Your digital brain.</h1>
          <p class="lede">Keep the thought, the conversation it came from, and the thing you promised to do next. All in one local-first workspace.</p>
          <div class="get-row">
            <GetButton />
            <a class="btn btn-ghost" href="#surfaces">Explore the app ↓</a>
          </div>
        </div>
        <figure class="field-note">
          <figcaption>Example meeting note</figcaption>
          <blockquote>“Let’s try the pilot with one team first. I’ll send Maya the checklist on Friday.”</blockquote>
          <dl>
            <div><dt>Decision</dt><dd>Start with one pilot team</dd></div>
            <div><dt>Follow-up</dt><dd>Send Maya the checklist</dd></div>
            <div><dt>Due</dt><dd>Friday</dd></div>
          </dl>
        </figure>
      </div>
    </section>

    <section class="section tour" id="surfaces" aria-labelledby="tour-title">
      <div class="wrap tour-intro">
        <h2 class="h2" id="tour-title">Where did we leave off?</h2>
        <p>Start in Today to see what needs your attention. Revisit a meeting for the exact words, or open someone’s profile before you follow up.</p>
      </div>
      <div class="surfaces" data-surfaces>
        <div class="wrap tabs-row">
          <div class="tabs" role="tablist" aria-label="Surfaces">
            {surfaces.map((surface, index) => (
              <button class="tab" role="tab" id={`tab-${surface.id}`} aria-controls={surface.id} aria-selected={index === 0} tabindex={index === 0 ? 0 : -1} type="button"><span class={`dot dot-${surface.color}`} aria-hidden="true"></span>{surface.label}</button>
            ))}
          </div>
          <button class="btn btn-ghost cycle-toggle" type="button" data-tour-toggle hidden><svg class="icon-pause" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" rx="1"/><rect x="7" y="1" width="3" height="10" rx="1"/></svg><svg class="icon-play" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 1.5v9a.5.5 0 0 0 .76.43l7.2-4.5a.5.5 0 0 0 0-.86l-7.2-4.5A.5.5 0 0 0 3 1.5Z"/></svg><span class="cycle-label">Pause tour</span></button>
        </div>

        <div class="stage panels">
          {surfaces.map((surface, index) => <SurfacePanel {...surface} selected={index === 0} />)}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="recall-title">
      <div class="wrap recall">
        <div>
          <h2 class="h2" id="recall-title">Find the detail you almost remember.</h2>
          <p>Remember a phrase but forget where you heard it? Search transcripts, notes, tasks and agent threads from the same place.</p>
          <dl class="shortcuts">
            <div><dt>Capture a thought</dt><dd><kbd>⌘ ⇧ Space</kbd></dd></div>
            <div><dt>Search your workspace</dt><dd><kbd>⌘ ⇧ F</kbd></dd></div>
          </dl>
        </div>
        <aside class="concept">
          <h3 class="h3">An idea we’re exploring</h3>
          <p>A 3D memory viewer could let you start at a meeting, follow a decision to the task it created, and jump back to the original passage.</p>
        </aside>
      </div>
    </section>

    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq">
        <h2 class="h2" id="faq-title" tabindex="-1">Questions</h2>
        <details>
          <summary>Where are my notes stored?</summary>
          <p>Your workspace lives on your machine. You can search your notes locally and choose what to share with an agent. <a href="/privacy">Read about data and privacy.</a></p>
        </details>
        <details>
          <summary>Is it free?</summary>
          <p>Yes. bruhs is MIT licensed, with no paid tier and no account to make. Your selected runtime uses its own subscription, API billing or local model.</p>
        </details>
        <details id="subs">
          <summary>Which agents can I use?</summary>
          <p>Choose Claude Code, Codex, Cursor, Antigravity, Grok or OpenCode for each thread. Each runtime uses its own login or configuration. OpenCode also supports local models.</p>
        </details>
        <details>
          <summary>Can I use an API key instead?</summary>
          <p>Yes. OpenCode uses your configured API providers, custom endpoints and local models. Pick its default model or enter <code>opencode/provider/model</code> in the model picker. Claude Code also supports an API key: set <code>BRUHS_CLAUDE_USE_API_KEY=1</code> to opt in. Codex uses whatever <code>codex login</code> set up.</p>
        </details>
        <details>
          <summary>Will an agent change my code without asking?</summary>
          <p>Default asks for approval in Claude Code and uses a read-only policy in the other runtimes. A runtime that cannot enforce the selected mode reports an error instead of running with broader access. Choose Accept edits or Full access when you want to allow changes.</p>
        </details>
        <details>
          <summary>Does a bot join my calls?</summary>
          <p>No. On macOS, bruhs records your microphone and system audio for calls in Zoom, Meet, Teams and other apps. Windows and Linux capture the microphone. Ask participants before recording.</p>
        </details>
        <details>
          <summary>What leaves my device?</summary>
          <p>Prompts and files you send to remote models go through your selected runtime and provider. A meeting's transcript goes to Claude when it summarizes it. Google Calendar, if you connect it. Update checks, which you can turn off. Recordings stay on your device unless you point transcription at your own server.</p>
        </details>
        <details>
          <summary>Does it work with my calendar?</summary>
          <p>Google Calendar, read-only, through a Google Cloud client you create (the README walks through it). Tasks and focus blocks live in bruhs's own calendar. Outlook and iCloud aren't supported yet.</p>
        </details>
        <details>
          <summary>Does it sync between my devices?</summary>
          <p>No. There's no bruhs server to sync through, so your data stays on this device.</p>
        </details>
        <details>
          <summary>What do I need to run it?</summary>
          <p>See the <a href="/download">download page</a> for platform requirements and the latest desktop builds.</p>
        </details>
      </div>
    </section>

    <section class="section" id="source" aria-labelledby="source-title">
      <div class="wrap open-source">
        <h2 class="h2" id="source-title" tabindex="-1">Open source, all of it.</h2>
        <p class="muted">MIT licensed. Read it, fork it, run it from source.</p>
        <div class="source-row">
          <p class="source" id="source-command" tabindex="0" aria-label="Run it from source"><span class="p" aria-hidden="true">$</span> <code>git clone https://github.com/bryantleft/bruhs-ai &amp;&amp; cd bruhs-ai &amp;&amp; scripts/dev.sh</code></p>
          <button class="btn btn-quiet copy" type="button" data-copy="source-command">Copy</button>
        </div>
        <p class="action-status" data-copy-status role="status"></p>
        <div class="get-row">
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai"><Icon name="github" />Read the source</a>
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai/blob/main/CONTRIBUTING.md">Contribute</a>
        </div>
      </div>
    </section>

    <section class="section closing" id="get" aria-labelledby="get-title">
      <div class="wrap">
        <h2 class="display display-sm" id="get-title" tabindex="-1">Start with a thought worth keeping.</h2>
        <div class="get-row">
          <GetButton />
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai/releases"><Icon name="github" />All releases</a>
        </div>
      </div>
      <canvas class="bruh bruh-peek" data-bruh="peek" aria-hidden="true"></canvas>
    </section>
  </main>

  <dialog slot="after" class="palette-dialog" aria-label="Jump to">
    <div class="palette" data-palette data-palette-mode="dialog">
      <div class="palette-input">
        <span class="prompt" aria-hidden="true">›</span>
        <label class="sr-only" for="dialog-palette-input">Jump to a part of bruhs</label>
        <input id="dialog-palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="dialog-palette-list" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="Jump to…">
        <button class="palette-close" type="button" data-close-palette aria-label="Close menu" title="Close (Esc)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button>
      </div>
      <ul class="palette-list" id="dialog-palette-list" role="listbox" aria-label="Commands"></ul>
      <p class="palette-empty" data-palette-empty role="status" hidden>Nothing matches. Try “tasks” or “privacy”.</p>
    </div>
  </dialog>
</Base>

<script>
  import "../scripts/site.js";
</script>
