---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import GetButton from "../components/GetButton.astro";
import CHANGELOG from "../../../CHANGELOG.md?raw";
import { inline, longDate, parseChangelog } from "../lib/changelog.js";

const latest = parseChangelog(CHANGELOG)[0];
if (!latest) throw new Error("CHANGELOG.md has no released version for the What's new section");
// The first three changes, Added first, as a preview of the full entry.
const highlights = latest.sections.flatMap((section) => section.items).slice(0, 3);
---

<Base
  title="bruhs: one window for your whole day"
  description="A local-first, keyboard-native agent for your whole day: coding agents, tasks, calendar, meetings, people, notes, money and health in one window. Free, open source, for macOS."
  ogDescription="Agents, tasks, calendar, meetings, people, notes, money and health. One ⌘K away, on your machine."
  path="/"
  current="home"
  palette
>
  <main id="main">
    <section class="hero">
      <div class="wrap hero-stack">
        <canvas class="bruh bruh-hero" data-bruh="hero" aria-hidden="true"></canvas>
        <h1 class="display">One window for your whole day.</h1>
        <p class="lede">Coding agents, tasks, calendar and meetings, a keystroke apart. On your Mac, not our cloud.</p>
        <div class="get-row">
          <GetButton />
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai"><Icon name="github" />GitHub</a>
        </div>
        <p class="os-note for-phone">bruhs is a Mac app. Send yourself the link and download it there.</p>
        <p class="os-note for-pc">The app is for Macs with Apple silicon. On Windows and Linux, bruhs runs from source in your browser.</p>
        <p class="works-with">Works with <span><img src="/logos/claude.svg" alt="" width="18" height="18" />Claude Code</span> and <span><img src="/logos/openai.svg" alt="" width="18" height="18" />Codex</span></p>
      </div>
    </section>

    <section class="section promises" aria-label="What stays yours">
      <ul class="wrap promise-list" role="list">
        <li id="privacy">
          <h2 class="h3" tabindex="-1">No bruhs cloud.</h2>
          <p>Threads, tasks, notes and people live on your Mac.</p>
        </li>
        <li>
          <h2 class="h3">No bot in your meetings.</h2>
          <p>Whisper transcribes on your Mac while the call happens.</p>
        </li>
        <li id="subs">
          <h2 class="h3" tabindex="-1">Your own login.</h2>
          <p>Runs the Claude Code and Codex you already pay for. No API keys, no resold tokens.</p>
        </li>
      </ul>
    </section>

    <section class="section tour" id="surfaces" aria-label="What's inside">
      <div class="surfaces" data-surfaces>
        <div class="wrap tabs-row">
          <div class="tabs" role="tablist" aria-label="Surfaces">
            <button class="tab" role="tab" id="tab-tasks" aria-controls="tasks" aria-selected="true" type="button"><span class="dot dot-tasks" aria-hidden="true"></span>Today</button>
            <button class="tab" role="tab" id="tab-meetings" aria-controls="meetings" aria-selected="false" tabindex="-1" type="button"><span class="dot dot-meetings" aria-hidden="true"></span>Meetings</button>
            <button class="tab" role="tab" id="tab-agents" aria-controls="agents" aria-selected="false" tabindex="-1" type="button"><span class="dot dot-agent" aria-hidden="true"></span>Agents</button>
            <button class="tab" role="tab" id="tab-calendar" aria-controls="calendar" aria-selected="false" tabindex="-1" type="button"><span class="dot dot-calendar" aria-hidden="true"></span>Calendar</button>
            <button class="tab" role="tab" id="tab-people" aria-controls="people" aria-selected="false" tabindex="-1" type="button"><span class="dot dot-people" aria-hidden="true"></span>People</button>
            <button class="tab" role="tab" id="tab-notes" aria-controls="notes" aria-selected="false" tabindex="-1" type="button"><span class="dot dot-notes" aria-hidden="true"></span>Notes</button>
            <button class="tab" role="tab" id="tab-life" aria-controls="life" aria-selected="false" tabindex="-1" type="button"><span class="dot dot-life" aria-hidden="true"></span>Life</button>
          </div>
          <button class="btn btn-ghost cycle-toggle" type="button" data-tour-toggle hidden><svg class="icon-pause" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" rx="1"/><rect x="7" y="1" width="3" height="10" rx="1"/></svg><svg class="icon-play" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 1.5v9a.5.5 0 0 0 .76.43l7.2-4.5a.5.5 0 0 0 0-.86l-7.2-4.5A.5.5 0 0 0 3 1.5Z"/></svg><span class="cycle-label">Pause tour</span></button>
        </div>

        <div class="stage panels">

          <div class="panel" role="tabpanel" id="tasks" aria-labelledby="tab-tasks" tabindex="0">
            <figure class="window">
              <img src="/shots/tasks-1168.webp" srcset="/shots/tasks-1168.webp 1168w, /shots/tasks-2336.webp 2336w" sizes="(min-width: 1168px) 1120px, calc(100vw - 48px)" width="1168" height="730" decoding="async"
                alt="The Today view: a briefing, the current focus block and the rest of the day's schedule, a ranked focus queue with priorities and estimates, and columns for overdue work, waiting on, follow-ups and decisions.">
            </figure>
            <p class="caption">Today: what's due, what's blocked, and who you're waiting on.</p>
          </div>

          <div class="panel" role="tabpanel" id="meetings" aria-labelledby="tab-meetings" tabindex="0" hidden>
            <figure class="window">
              <img src="/shots/meetings-1168.webp" srcset="/shots/meetings-1168.webp 1168w, /shots/meetings-2336.webp 2336w" sizes="(min-width: 1168px) 1120px, calc(100vw - 48px)" width="1168" height="730" loading="lazy" decoding="async"
                alt="A recorded meeting: the end of a speaker-labeled transcript, then a summary, four action items with due dates, the decisions made, and topics.">
            </figure>
            <p class="caption">Meeting notes without a bot in the call, transcribed on your Mac.</p>
          </div>
          <div class="panel" role="tabpanel" id="agents" aria-labelledby="tab-agents" tabindex="0" hidden>
            <figure class="window">
              <img src="/shots/hero-1440.webp" srcset="/shots/hero-1440.webp 1440w, /shots/hero-2880.webp 2880w" sizes="(min-width: 1168px) 1120px, calc(100vw - 48px)" width="1440" height="900" loading="lazy" decoding="async"
                alt="The bruhs app: a sidebar of Claude and Codex threads across several projects, and an open thread where Claude reads session.rs, runs cargo test, explains a race on a shared test clock, and shows a two-file diff.">
            </figure>
            <p class="caption">Claude Code and Codex threads, with every tool call, diff and a terminal.</p>
          </div>

          <div class="panel" role="tabpanel" id="calendar" aria-labelledby="tab-calendar" tabindex="0" hidden>
            <figure class="window">
              <img src="/shots/calendar-1168.webp" srcset="/shots/calendar-1168.webp 1168w, /shots/calendar-2336.webp 2336w" sizes="(min-width: 1168px) 1120px, calc(100vw - 48px)" width="1168" height="730" loading="lazy" decoding="async"
                alt="A week in the bruhs calendar: meetings, blue focus blocks for tasks like the flaky auth test and the launch post, green workouts, and evening plans, with a line marking the current time on Wednesday.">
            </figure>
            <p class="caption">“Plan my day” turns estimates into focus blocks around your meetings.</p>
          </div>

          <div class="panel" role="tabpanel" id="people" aria-labelledby="tab-people" tabindex="0" hidden>
            <figure class="window">
              <img src="/shots/people-1168.webp" srcset="/shots/people-1168.webp 1168w, /shots/people-2336.webp 2336w" sizes="(min-width: 1168px) 1120px, calc(100vw - 48px)" width="1168" height="730" loading="lazy" decoding="async"
                alt="A person in bruhs: company, role and contact details, private notes, a suggested follow-up, and a list of commitments, reminders and past interactions.">
            </figure>
            <p class="caption">A CRM that fills itself in from your meetings and messages.</p>
          </div>

          <div class="panel" role="tabpanel" id="notes" aria-labelledby="tab-notes" tabindex="0" hidden>
            <figure class="window">
              <img src="/shots/notes-1168.webp" srcset="/shots/notes-1168.webp 1168w, /shots/notes-2336.webp 2336w" sizes="(min-width: 1168px) 1120px, calc(100vw - 48px)" width="1168" height="730" loading="lazy" decoding="async"
                alt="The Notes view: tagged Markdown documents such as a pilot plan and a launch checklist, and saved web clips that keep their source.">
            </figure>
            <p class="caption">Docs and web clips your agent can read.</p>
          </div>

          <div class="panel" role="tabpanel" id="life" aria-labelledby="tab-life" tabindex="0" hidden>
            <figure class="window">
              <img src="/shots/life-1168.webp" srcset="/shots/life-1168.webp 1168w, /shots/life-2336.webp 2336w" sizes="(min-width: 1168px) 1120px, calc(100vw - 48px)" width="1168" height="730" loading="lazy" decoding="async"
                alt="The finance side of Life: net worth, 30-day spend and expected income, the agent-access and redaction switches, a list of accounts, and recent transactions.">
            </figure>
            <p class="caption">Money and health, hidden from the agent until you opt in.</p>
          </div>
        </div>
      </div>
    </section>

    <section class="section flow-section" id="flow" aria-labelledby="flow-title">
      <div class="wrap">
        <h2 class="h2" id="flow-title" tabindex="-1">One thing leads to the next.</h2>
        <ol class="flow" role="list">
          <li><span class="flow-dot dot-meetings" aria-hidden="true"></span><b>A meeting ends</b><span>and its action items land in Today.</span></li>
          <li><span class="flow-dot dot-agent" aria-hidden="true"></span><b>A task goes to Claude</b><span>and runs in its own thread, with a diff to review.</span></li>
          <li><span class="flow-dot dot-calendar" aria-hidden="true"></span><b>Your calendar makes room</b><span>to review what it did.</span></li>
        </ol>
      </div>
    </section>

    <section class="section" id="new" aria-labelledby="new-title">
      <div class="wrap news">
        <h2 class="h2" id="new-title" tabindex="-1">What's new in v{latest.version}</h2>
        <p class="muted"><time datetime={latest.date}>{longDate(latest.date)}</time></p>
        {latest.summary && <p class="news-summary" set:html={inline(latest.summary)} />}
        <ul class="news-list" role="list">
          {/* One <span> per item: the <li> is a two-column grid (dash, text). */}
          {highlights.map((item) => <li><span set:html={inline(item)} /></li>)}
        </ul>
        <a class="btn btn-ghost" href={`/changelog#v${latest.version}`}>Read the changelog</a>
      </div>
    </section>

    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq">
        <h2 class="h2" id="faq-title" tabindex="-1">Questions</h2>
        <details>
          <summary>How is it different from Claude Code or Codex?</summary>
          <p>It runs them. bruhs drives the Claude Code and Codex you already have, on your own login, and puts your tasks, calendar, meetings, people and notes in the same window, so an agent can work from your day. Bring your threads over from Claude Code, Codex, T3 Code or Cursor, and continue any thread back in Claude Code, Codex or T3 Code.</p>
        </details>
        <details>
          <summary>Is it free?</summary>
          <p>Yes. bruhs is MIT licensed, with no paid tier and no account to make. Agents run on the Claude or ChatGPT plan you already pay for.</p>
        </details>
        <details>
          <summary>Can I use an API key instead?</summary>
          <p>Yes, for Claude. bruhs ignores <code>ANTHROPIC_API_KEY</code> by default so a stray key doesn't switch you to per-token billing; set <code>BRUHS_CLAUDE_USE_API_KEY=1</code> to use it. Codex uses whatever <code>codex login</code> set up.</p>
        </details>
        <details>
          <summary>Will an agent change my code without asking?</summary>
          <p>Not in the default mode. Claude asks before it edits a file or runs a command, and Codex, which can't ask, runs read-only. Auto-accept lets either one write. Every change shows up in the diff panel, and Edit from here rewinds a thread and its files to an earlier message.</p>
        </details>
        <details>
          <summary>Does a bot join my calls?</summary>
          <p>No. bruhs records your microphone and your Mac's audio, so it works with Zoom, Meet, Teams or anything else that makes sound, and nobody sees a bot. It doesn't tell anyone you're recording, so ask first; some places require everyone's consent.</p>
        </details>
        <details>
          <summary>What leaves my Mac?</summary>
          <p>What you send to Claude or Codex, through your own login, including a meeting's transcript when Claude summarizes it. Google Calendar, if you connect it. Update checks, which you can turn off. Recordings stay on your Mac unless you point transcription at your own server.</p>
        </details>
        <details>
          <summary>Does it work with my calendar?</summary>
          <p>Google Calendar, read-only, through a Google Cloud client you create (the README walks through it). Tasks and focus blocks live in bruhs's own calendar. Outlook and iCloud aren't supported yet.</p>
        </details>
        <details>
          <summary>Does it sync between my devices?</summary>
          <p>No. There's no bruhs server to sync through, so your data stays on the Mac it's on.</p>
        </details>
        <details>
          <summary>What do I need to run it?</summary>
          <p>A Mac on Apple silicon with macOS 13 or later. On Windows and Linux there's no download yet: bruhs runs from source in the browser, and meetings record the microphone only.</p>
        </details>
      </div>
    </section>

    <section class="section" id="source" aria-labelledby="source-title">
      <div class="wrap open-source">
        <h2 class="h2" id="source-title" tabindex="-1">Open source, all of it.</h2>
        <p class="muted">MIT licensed. Read it, fork it, run it from source.</p>
        <div class="source-row">
          <p class="source" id="source-command" tabindex="0" aria-label="Run it from source"><span class="p">$</span> git clone https://github.com/bryantleft/bruhs-ai &amp;&amp; cd bruhs-ai &amp;&amp; scripts/dev.sh</p>
          <button class="btn btn-quiet copy" type="button" data-copy="source-command" aria-live="polite">Copy</button>
        </div>
        <div class="get-row">
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai"><Icon name="github" />Read the source</a>
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai/blob/main/CONTRIBUTING.md">Contribute</a>
        </div>
      </div>
    </section>

    <section class="section closing" id="get" aria-labelledby="get-title">
      <div class="wrap">
        <h2 class="display display-sm" id="get-title" tabindex="-1">Close the other twelve tabs.</h2>
        <div class="get-row">
          <GetButton />
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai/releases"><Icon name="github" />All releases</a>
        </div>
      </div>
      <canvas class="bruh bruh-peek" data-bruh="peek" aria-hidden="true"></canvas>
    </section>
  </main>

  <dialog slot="after" class="palette-dialog" aria-label="Jump to">
    <div class="palette" data-palette data-palette-mode="dialog">
      <div class="palette-input">
        <span class="prompt" aria-hidden="true">›</span>
        <label class="sr-only" for="dialog-palette-input">Jump to a part of bruhs</label>
        <input id="dialog-palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="dialog-palette-list" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="Jump to…">
        <kbd>esc</kbd>
      </div>
      <ul class="palette-list" id="dialog-palette-list" role="listbox" aria-label="Commands"></ul>
    </div>
  </dialog>
</Base>

<script>
  import "../scripts/site.js";
</script>
