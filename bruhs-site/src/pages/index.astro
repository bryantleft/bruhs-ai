---
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import GetButton from "../components/GetButton.astro";
import SurfacePanel from "../components/SurfacePanel.astro";

const surfaces = [
  { id: "tasks", label: "Today", color: "tasks", file: "tasks", width: 1168,
    alt: "The Today view: a briefing, the current focus block and the rest of the day's schedule, a ranked focus queue with priorities and estimates, and columns for overdue work, waiting on, follow-ups and decisions.",
    caption: "Everything due today, what is blocked, and who you are waiting on." },
  { id: "meetings", label: "Meetings", color: "meetings", file: "meetings", width: 1168,
    alt: "A recorded meeting: the end of a speaker-labeled transcript, then a summary, four action items with due dates, the decisions made, and topics.",
    caption: "Meeting notes with no bot joining your call, transcribed right on your machine." },
  { id: "agents", label: "Agents", color: "agent", file: "hero", width: 1440,
    alt: "The bruhs app: a sidebar of Claude and Codex threads across several projects, and an open thread where Claude reads session.rs, runs cargo test, explains a race on a shared test clock, and shows a two-file diff.",
    caption: "Run Claude Code, Codex, and other agents side by side, with every diff, tool call, and terminal right there." },
  { id: "calendar", label: "Calendar", color: "calendar", file: "calendar", width: 1168,
    alt: "A week in the bruhs calendar: meetings, blue focus blocks for tasks like the flaky auth test and the launch post, green workouts, and evening plans, with a line marking the current time on Wednesday.",
    caption: "Ask bruhs to plan your day and it turns your task estimates into focus blocks around your meetings." },
  { id: "people", label: "People", color: "people", file: "people", width: 1168,
    alt: "A person in bruhs: company, role and contact details, private notes, a suggested follow-up, and a list of commitments, reminders and past interactions.",
    caption: "Every note, past conversation, and promise you made, organized by the person it belongs to." },
  { id: "notes", label: "Notes", color: "notes", file: "notes", width: 1168,
    alt: "The Notes view: tagged Markdown documents such as a pilot plan and a launch checklist, and saved web clips that keep their source.",
    caption: "Plain Markdown notes and saved web clips that your agents can actually read." },
  { id: "life", label: "Life", color: "life", file: "life", width: 1168,
    alt: "The finance side of Life: net worth, 30-day spend and expected income, the agent-access and redaction switches, a list of accounts, and recent transactions.",
    caption: "Track your finances and health privately. Nothing is shared with an agent unless you turn it on." },
];
---

<Base
  title="bruhs | Your digital brain"
  description="One local workspace where your AI agents, meeting notes, tasks, and people share context. Free and open source for macOS, Windows, and Linux."
  ogDescription="Recall the decision from your last meeting, keep track of who you owe a reply, and see what matters today."
  path="/"
  current="home"
  palette
>
  <main id="main" tabindex="-1">
    <section class="hero">
      <div class="wrap hero-stack">
        <canvas class="bruh bruh-hero" data-bruh="hero" aria-hidden="true"></canvas>
        <h1 class="display">Your digital brain.</h1>
        <p class="lede">One local workspace where your AI agents, meeting notes, and daily work actually share context.</p>
        <div class="get-row">
          <GetButton />
        </div>
        <p class="hero-note">Free and open source. No account required.</p>
      </div>
    </section>

    <section class="section tour" id="surfaces" aria-label="Product tour">
      <div class="surfaces" data-surfaces>
        <div class="wrap tabs-row">
          <div class="tabs" role="tablist" aria-label="Surfaces">
            {surfaces.map((surface, index) => (
              <button class="tab" role="tab" id={`tab-${surface.id}`} aria-controls={surface.id} aria-selected={index === 0} tabindex={index === 0 ? 0 : -1} type="button"><span class={`dot dot-${surface.color}`} aria-hidden="true"></span>{surface.label}</button>
            ))}
          </div>
          <button class="btn btn-ghost cycle-toggle" type="button" data-tour-toggle hidden><svg class="icon-pause" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><rect x="2" y="1" width="3" height="10" rx="1"/><rect x="7" y="1" width="3" height="10" rx="1"/></svg><svg class="icon-play" viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M3 1.5v9a.5.5 0 0 0 .76.43l7.2-4.5a.5.5 0 0 0 0-.86l-7.2-4.5A.5.5 0 0 0 3 1.5Z"/></svg><span class="cycle-label">Pause tour</span></button>
        </div>

        <div class="stage panels">
          {surfaces.map((surface, index) => <SurfacePanel {...surface} selected={index === 0} />)}
        </div>
      </div>
    </section>

    <section class="section" id="faq" aria-labelledby="faq-title">
      <div class="wrap faq">
        <h2 class="h2" id="faq-title" tabindex="-1">Questions</h2>
        <details>
          <summary>Where does my data live?</summary>
          <p>Right on your machine. Search works offline, and you decide what an agent gets to see. <a href="/privacy">Read about data and privacy.</a></p>
        </details>
        <details>
          <summary>Is it free?</summary>
          <p>Yes. bruhs is open source under the MIT license, with no paid tier and no account to create. Any AI runtime you connect uses your own subscription, API key, or local model.</p>
        </details>
        <details id="subs">
          <summary>Which agents can I use?</summary>
          <p>Pick Claude Code, Codex, Cursor, Antigravity, Grok, or OpenCode per thread. Each runtime uses the login or config you already have, and OpenCode lets you run local models too.</p>
        </details>
        <details>
          <summary>Can I use an API key instead?</summary>
          <p>Yes. OpenCode works with your own API providers, custom endpoints, and local models. Pick its default model or type <code>opencode/provider/model</code> in the picker. Claude Code supports an API key when you set <code>BRUHS_CLAUDE_USE_API_KEY=1</code>, and Codex uses whatever <code>codex login</code> configured.</p>
        </details>
        <details>
          <summary>Will an agent change my code without asking?</summary>
          <p>Not by default. Claude Code asks before editing, and other runtimes stay read only unless you switch to Accept edits or Full access. If a runtime cannot enforce the mode you picked, bruhs stops with an error instead of silently granting more access.</p>
        </details>
        <details>
          <summary>Does a bot join my calls?</summary>
          <p>Never. On macOS, bruhs captures your microphone and system audio directly from Zoom, Meet, Teams, or any other app. Windows and Linux record from your microphone. Just remember to let people know before you hit record.</p>
        </details>
        <details>
          <summary>What leaves my device?</summary>
          <p>Cloud models receive the prompts, attachments, and context they need to respond. Audio is transcribed locally by default. Choosing cloud speech or a remote transcription endpoint sends audio to that service. Connected services such as Google Calendar sync with their providers.</p>
          <p>Bruhs disables built-in analytics for the Claude Code, Codex, and Grok agent sessions it starts. Other runtimes can send their own telemetry. Update checks run by default and can be turned off in Settings. Diagnostic export starts off and sends request metadata to the receiver you configure. <a href="/privacy">Read the privacy details.</a></p>
        </details>
        <details>
          <summary>Does it work with my calendar?</summary>
          <p>It connects to Google Calendar in read only mode using your own Google Cloud client (the README walks you through setup). Tasks and focus blocks live inside bruhs. Outlook and iCloud are not supported yet.</p>
        </details>
        <details>
          <summary>Does it sync between my devices?</summary>
          <p>Not right now. There is no bruhs cloud server in the middle, so everything stays on the machine you run it on.</p>
        </details>
        <details>
          <summary>What do I need to run it?</summary>
          <p>Check the <a href="/download">download page</a> for supported systems and the latest builds.</p>
        </details>
      </div>
    </section>

    <section class="section" id="source" aria-labelledby="source-title">
      <div class="wrap open-source">
        <h2 class="h2" id="source-title" tabindex="-1">Run from source</h2>
        <div class="source-row">
          <p class="source" id="source-command" tabindex="0" aria-label="Run it from source"><span class="p" aria-hidden="true">$</span> <code>git clone https://github.com/bryantleft/bruhs-ai &amp;&amp; cd bruhs-ai &amp;&amp; scripts/dev.sh</code></p>
          <button class="btn btn-quiet copy" type="button" data-copy="source-command">Copy</button>
        </div>
        <p class="action-status" data-copy-status role="status"></p>
        <div class="get-row">
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai"><Icon name="github" />Browse on GitHub</a>
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai/blob/main/CONTRIBUTING.md">Contribute</a>
        </div>
      </div>
    </section>

    <section class="section closing" id="get" aria-labelledby="get-title">
      <div class="wrap">
        <h2 class="display display-sm" id="get-title" tabindex="-1">Ready to try it?</h2>
        <div class="get-row">
          <GetButton />
          <a class="btn btn-ghost" href="https://github.com/bryantleft/bruhs-ai/releases"><Icon name="github" />All releases</a>
        </div>
      </div>
      <canvas class="bruh bruh-peek" data-bruh="peek" aria-hidden="true"></canvas>
    </section>
  </main>

  <dialog slot="after" class="palette-dialog" aria-label="Jump to">
    <div class="palette" data-palette data-palette-mode="dialog">
      <div class="palette-input">
        <span class="prompt" aria-hidden="true">›</span>
        <label class="sr-only" for="dialog-palette-input">Jump to a part of bruhs</label>
        <input id="dialog-palette-input" type="text" role="combobox" aria-expanded="true" aria-controls="dialog-palette-list" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="Jump to…">
        <button class="palette-close" type="button" data-close-palette aria-label="Close menu" title="Close (Esc)"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m6 6 12 12M6 18 18 6"/></svg></button>
      </div>
      <ul class="palette-list" id="dialog-palette-list" role="listbox" aria-label="Commands"></ul>
      <p class="palette-empty" data-palette-empty role="status" hidden>Nothing matches. Try “tasks” or “privacy”.</p>
    </div>
  </dialog>
</Base>

<script>
  import "../scripts/site.js";
</script>
