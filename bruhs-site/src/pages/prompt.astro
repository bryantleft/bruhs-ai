---
import Base from "../layouts/Base.astro";
---

<Base
  title="Open a prompt · Bruhs"
  description="Review a shared prompt and open it as a draft in Bruhs."
  path="/prompt"
  fonts={["Xenon", "Neon", "Argon"]}
  noIndex
>
  <main id="main" class="prompt-page">
    <div class="wrap">
      <h1 class="h2" data-prompt-title>Open a prompt</h1>
      <p class="lede" data-prompt-status role="status">Open the full link to see its draft.</p>
      <p class="prompt-warning" data-prompt-warning hidden>
        Hidden characters were removed. Review the text before sending.
      </p>
      <pre class="prompt-text" data-prompt-text aria-label="Linked prompt" tabindex="0" hidden></pre>
      <p class="label" data-prompt-destination hidden></p>
      <div class="prompt-actions" data-prompt-actions hidden>
        <a class="btn btn-primary" data-open-app>Open in app</a>
        <button class="btn btn-quiet" type="button" data-open-browser aria-expanded="false" aria-controls="prompt-browser">Continue in browser</button>
      </div>
      <form class="prompt-form" id="prompt-browser" data-prompt-form hidden>
        <label class="label" for="prompt-workspace">Bruhs workspace URL</label>
        <p class="label" id="prompt-workspace-hint">Use the address where you already open Bruhs.</p>
        <div class="prompt-actions">
          <input id="prompt-workspace" type="url" autocomplete="url" inputmode="url" required placeholder="http://localhost:3001" aria-describedby="prompt-workspace-hint prompt-workspace-error" />
          <button class="btn btn-quiet" type="submit">Open draft</button>
        </div>
        <p class="prompt-warning" id="prompt-workspace-error" aria-live="polite" hidden></p>
      </form>
      <div class="prompt-footer" data-prompt-footer hidden>
        <label class="label"><input type="checkbox" data-remember />Remember my choice</label>
        <a href="/download">Get Bruhs</a>
      </div>
    </div>
  </main>
</Base>

<script>
  import "../scripts/prompt.ts";
</script>

<style>
  .prompt-page { flex: 1; padding-block: clamp(48px, 9vw, 104px); }
  .prompt-page .wrap { max-width: 680px; }
  .prompt-page [hidden] { display: none; }
  .prompt-page .lede { margin-top: 10px; }
  .prompt-text {
    background: var(--longan-900);
    box-shadow: inset 0 0 0 1px var(--ring-10);
    border-radius: var(--grape);
    margin: 24px 0 10px;
    max-height: 260px;
    overflow: auto;
    overflow-wrap: anywhere;
    padding: 16px;
    white-space: pre-wrap;
    font: inherit;
  }
  .prompt-warning { color: var(--lychee-300); font-size: .875rem; }
  .prompt-actions, .prompt-footer { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; }
  [data-prompt-actions] { margin-top: 20px; }
  .prompt-form, .prompt-footer { margin-top: 16px; }
  .prompt-form p, .prompt-footer a { font-size: .875rem; }
  .prompt-form input {
    flex: 1 1 240px;
    min-width: 0;
    min-height: 44px;
    padding: 6px 12px;
    border: 1px solid var(--ring-10);
    border-radius: var(--grape);
    background: var(--longan-900);
    color: var(--rambutan-100);
    font: inherit;
  }
  .prompt-footer label { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; }
  .prompt-footer input { accent-color: var(--persimmon-500); }
  .prompt-footer a { color: var(--rambutan-300); }
</style>
