+// Pause prevents future dispatches of an entry and reports a state change.
+// It does not cancel work that the scheduler has already dispatched.
+func (c *Cron) Pause(id EntryID) bool { return c.changePaused(id, true) }
+
+// Resume reactivates a paused entry and reports a state change. While running,
+// its next occurrence is computed from current time without replaying missed work.
+func (c *Cron) Resume(id EntryID) bool { return c.changePaused(id, false) }
+
+func (c *Cron) changePaused(id EntryID, paused bool) bool {
+	c.runningMu.Lock()
+	defer c.runningMu.Unlock()
+	if !c.running {
+		return c.setPaused(id, paused, false, time.Time{})
+	}
+	reply := make(chan bool, 1)
+	c.pause <- pauseRequest{id: id, paused: paused, reply: reply}
+	return <-reply
+}
+
+func (c *Cron) setPaused(id EntryID, paused, running bool, now time.Time) bool {
+	for _, entry := range c.entries {
+		if entry.ID == id {
+			if entry.Paused == paused {
+				return false
+			}
+			entry.Paused = paused
+			entry.Next = time.Time{}
+			if !paused && running {
+				entry.Next = entry.Schedule.Next(now)
+			}
+			return true
+		}
+	}
+	return false
+}
+
