+++ b/reference_pause_test.go
@@ -0,0 +1,24 @@
+package cron_test
+
+import (
+	cron "github.com/robfig/cron/v3"
+	"testing"
+)
+
+func TestPauseReferenceDuplicate(t *testing.T) {
+	c := cron.New()
+	id, err := c.AddFunc("@every 1h", func() {})
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !c.Pause(id) || c.Pause(id) {
+		t.Fatal("Pause did not report transitions")
+	}
+	if !c.Resume(id) || c.Resume(id) {
+		t.Fatal("Resume did not report transitions")
+	}
+	c.Remove(id)
+	if c.Resume(id) {
+		t.Fatal("removed entry was recreated")
+	}
+}
