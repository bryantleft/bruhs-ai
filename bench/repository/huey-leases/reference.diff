@@ -0,0 +1,22 @@
+import tempfile
+import unittest
+from pathlib import Path
+from huey.storage import SqliteStorage
+
+class LeaseRecoveryTest(unittest.TestCase):
+    def test_reopening_keeps_a_live_lease_then_fences_expired_ack(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            path = str(Path(tmp) / 'queue.db')
+            first = SqliteStorage('q', filename=path)
+            first.enqueue(b'work')
+            old, _ = first.reserve(5, now=10)
+            first.close()
+            second = SqliteStorage('q', filename=path)
+            try:
+                self.assertIsNone(second.reserve(5, now=14))
+                new, data = second.reserve(5, now=15)
+                self.assertEqual(data, b'work')
+                self.assertFalse(second.ack(old, now=16))
+                self.assertTrue(second.ack(new, now=16))
+            finally:
+                second.close()
