+    def _require_leased_queue(self):
+        if self.immediate:
+            raise ValueError('Leased delivery is unavailable in immediate mode.')
+
+    def reserve_task(self, lease_for, now=None):
+        self._require_leased_queue()
+        result = self.storage.reserve(lease_for, now=now)
+        if result is None:
+            return None
+        token, data = result
+        try:
+            task = self.deserialize_task(data)
+        except Exception:
+            self.storage.release(token, now=now)
+            raise
+        return token, task
+
+    def ack_task(self, token, now=None):
+        self._require_leased_queue()
+        return self.storage.ack(token, now=now)
+
+    def renew_task(self, token, lease_for, now=None):
+        self._require_leased_queue()
+        return self.storage.renew(token, lease_for, now=now)
+
+    def release_task(self, token, now=None):
+        self._require_leased_queue()
+        return self.storage.release(token, now=now)
